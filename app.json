{
  "expo": {
    "name": "Nexus",
    "slug": "nexus-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexus",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexus.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#805600",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.nexus.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#fcf9f8"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nexus to access your photos to upload images.",
          "cameraPermission": "Allow Nexus to access your camera to take photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
